{% for sc in scorecards -%}
{% if cat in sc.categories -%}
{% if cat not in active_cats -%}
{% if active_cats.append(cat) %}{% endif -%}
{% endif -%}
{% endif -%}
{% endfor -%}
{% endfor -%}
