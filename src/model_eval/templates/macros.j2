{%- set d = h2h.deltas[i] -%}
{%- set winner = h2h.model_a if d > 0 else (h2h.model_b if d < 0 else 'Tie') -%}
{%- set fmt_delta = '+%.1f'|format(d) if d > 0 else '%.1f'|format(d) -%}
{%- set bold = (d|abs > 25) -%}
| {{ h2h.dimensions[i] }} | {{ '%.1f'|format(h2h.a_scores[i]) }} | {{ '%.1f'|format(h2h.b_scores[i]) }} | {% if bold %}**{{ fmt_delta }}**{% else %}{{ fmt_delta }}{% endif %} | {{ winner }} |
{% endfor -%}
{%- endmacro -%}

{%- macro provenance_label(prov) -%}
{%- if prov == "both" %}[B]{% elif prov == "arena_only" %}[A]{% elif prov == "aa_only" %}[AA]{% elif prov == "mixed" %}[M]{% else %}[?]{% endif -%}
{%- endmacro -%}

{%- macro fmt_percentile(val) -%}
{{ "%.1f"|format(val) }}
{%- endmacro -%}

{%- macro match_type_label(mt) -%}
{%- if mt and mt.value == "exact" %}exact{% elif mt and mt.value == "equivalent" %}equivalent{% elif mt and mt.value == "fuzzy" %}fuzzy{% else %}not found{% endif -%}
{%- endmacro -%}

